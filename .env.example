# Copy to .env and customize:
#   cp .env.example .env
#
# Generate JWT_SECRET: openssl rand -base64 32
# Docker Compose requires JWT_SECRET to be set (no placeholder).

# Required
DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET=""

# Optional
JWT_EXPIRATION="7d"
ALLOW_PUBLIC_REGISTRATION="true"
NODE_ENV="development"

# PostgreSQL (optional)
# DATABASE_URL="postgresql://user:password@localhost:5432/product_docs?schema=public"
