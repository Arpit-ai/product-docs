// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  password  String
  role      UserRole   @default(EDITOR)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  documents   Document[]
  versions    Version[]
  uploads     Media[]
  activityLogs ActivityLog[]
  templates   Template[]
  documentAccess DocumentAccess[]
  folderAccess FolderAccess[]
  sharedLinks SharedLink[]
  aiRequests AIRequest[]
  apiTokens  ApiToken[]
  webhookEndpoints WebhookEndpoint[]

  notifications Notification[]
  notificationPreference NotificationPreference?
  @@map("users")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum AccessRole {
  OWNER
  EDITOR
  COMMENTER
  VIEWER
}

model Folder {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  parent    Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderHierarchy")
  documents Document[]
  templates Template[]
  folderAccess FolderAccess[]

  @@map("folders")
}

model Document {
  id        String     @id @default(cuid())
  title     String
  slug      String     @unique
  content   String     @default("")
  status    DocumentStatus @default(DRAFT)
  folderId  String?
  createdBy String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  folder    Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  creator   User       @relation(fields: [createdBy], references: [id])
  versions     Version[]
  tags         Tag[]
  activityLogs ActivityLog[]
  documentAccess DocumentAccess[]
  aiRequests AIRequest[]

  @@map("documents")
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Version {
  id        String     @id @default(cuid())
  content   String
  documentId String
  userId    String
  changeSummary String @default("")
  createdAt DateTime   @default(now())

  document  Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])

  @@map("versions")
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  documents Document[]
  createdAt DateTime   @default(now())

  @@map("tags")
}

model Media {
  id        String     @id @default(cuid())
  filename  String
  filepath  String
  mimeType  String
  size      Int
  uploadedBy String
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [uploadedBy], references: [id])

  @@map("media")
}

model ActivityLog {
  id         String    @id @default(cuid())
  action     String
  userId     String
  documentId String?
  metadata   String    @default("")
  createdAt  DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id])
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model Template {
  id        String   @id @default(cuid())
  name      String
  blocks    Json     // EditorJS block structure
  folderId  String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  user      User     @relation(fields: [createdBy], references: [id])

  @@map("templates")
}

model DocumentAccess {
  id        String   @id @default(cuid())
  documentId String
  userId    String?
  email     String?
  role      AccessRole @default(VIEWER)
  createdAt DateTime @default(now())
  expiresAt DateTime?

  document  Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@unique([documentId, email])
  @@map("document_access")
}

model FolderAccess {
  id       String   @id @default(cuid())
  folderId String
  userId   String
  role     AccessRole @default(VIEWER)
  createdAt DateTime @default(now())

  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
  @@map("folder_access")
}

model SharedLink {
  id          String   @id @default(cuid())
  resourceType String  // "document" or "folder"
  resourceId  String
  token       String   @unique
  expiresAt   DateTime?
  password    String?
  viewCount   Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now())

  user        User    @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("shared_links")
}

model Invitation {
  id       String   @id @default(cuid())
  email    String
  resourceType String // "document" or "folder"
  resourceId String
  role     AccessRole
  accepted Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, resourceId])
  @@map("invitations")
}

model AIRequest {
  id        String   @id @default(cuid())
  userId    String
  documentId String
  operation String   // "generate", "summarize", "translate", "fixGrammar", "qa"
  inputText String   
  outputText String  
  metadata  String?  // JSON string for additional context
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@map("ai_requests")
}

model ApiToken {
  id        String   @id @default(cuid())
  token     String   @unique
  name      String
  userId    String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  userId    String
  url       String
  secret    String
  events    String   // JSON array of event types
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  endpointId String
  eventType  String
  payload    String   // JSON payload
  status     String   // "pending", "delivered", "failed"
  statusCode Int?
  retries    Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())
  deliveredAt DateTime?

  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([status])
  @@map("webhook_deliveries")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "mention", "comment", "share", "update"
  title     String
  message   String
  resourceType String?  // "document", "comment", etc
  resourceId String?
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  emailMentions Boolean @default(true)
  emailComments Boolean @default(true)
  emailShares Boolean @default(true)
  emailUpdates Boolean @default(false)
  emailDigestFrequency String @default("instant")  // "instant", "daily", "weekly"
  inAppMentions Boolean @default(true)
  inAppComments Boolean @default(true)
  inAppShares Boolean @default(true)
  inAppUpdates Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
